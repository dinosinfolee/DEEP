{
  // Cloudflare Workers 정적 자산 배포 설정.
  //
  //   npx wrangler deploy
  //
  // 코드는 한 줄도 없다. Worker는 이 폴더의 파일을 내려주기만 하고,
  // 전처리·회귀·군집은 전부 학생 브라우저 안에서 돈다.
  //
  // 정적 자산 요청은 Worker 요청 수에 포함되지 않는다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deep",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./",
    // 해시(#)로만 상태를 넘기므로 서버 쪽 라우팅이 필요 없다.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
